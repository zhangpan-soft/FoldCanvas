{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foldcanvas.dev/schema/foldcanvas-public-release-identities.schema.json",
  "title": "FoldCanvas immutable public release identities",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "packageName", "releases"],
  "properties": {
    "format": { "const": "foldcanvas-public-release-identities" },
    "version": { "const": "1" },
    "packageName": { "const": "com.foldcanvas.core" },
    "releases": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/release" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageVersion",
        "tag",
        "tagCommit",
        "releaseId",
        "publishedAt",
        "archiveSha256",
        "checksumSha256",
        "manifestSha256",
        "evidenceSha256",
        "assetCount",
        "immutable"
      ],
      "properties": {
        "packageVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "tag": { "type": "string", "pattern": "^v" },
        "tagCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "releaseId": { "type": "integer", "minimum": 1 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "checksumSha256": { "$ref": "#/$defs/sha256" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" },
        "assetCount": { "const": 4 },
        "immutable": { "const": true }
      }
    }
  }
}
